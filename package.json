{
  "name": "linyuan-canon-runtime",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:runtime": "tsx --test runtime/tests/*.test.ts",
    "test:eval": "tsx --test evals/tests/*.test.ts",
    "test": "npm run test:runtime && npm run test:eval",
    "lint:registry": "tsx runtime/ci/lint-registry.ts",
    "eval": "tsx evals/runner.ts",
    "eval:smoke": "tsx evals/runner.ts --enforce",
    "ci": "npm run typecheck && npm test && npm run lint:registry && npm run eval:smoke"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "^2.8.0"
  }
}
