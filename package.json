{
  "name": "linyuan-canon-runtime",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:runtime": "node --import tsx --test runtime/tests/*.test.ts",
    "test:eval": "node --import tsx --test evals/tests/*.test.ts",
    "test": "npm run test:runtime && npm run test:eval",
    "lint:registry": "node --import tsx runtime/ci/lint-registry.ts",
    "eval": "node --import tsx evals/runner.ts",
    "eval:smoke": "node --import tsx evals/runner.ts --enforce",
    "ci": "npm run typecheck && npm test && npm run lint:registry && npm run eval:smoke && npm run fiction:help && npm run fiction:live:help && npm run fiction:verify:help",
    "eval:real": "node --import tsx evals/real-runner.ts",
    "eval:verify-baseline": "node --import tsx evals/verify-baseline.ts",
    "fiction": "node --import tsx runtime/fiction-cli.ts",
    "fiction:help": "node --import tsx runtime/fiction-cli.ts --help",
    "fiction:live": "node --import tsx runtime/live-fiction-cli.ts",
    "fiction:live:help": "node --import tsx runtime/live-fiction-cli.ts --help",
    "fiction:verify": "node --import tsx runtime/verify-live-bundle-cli.ts",
    "fiction:verify:help": "node --import tsx runtime/verify-live-bundle-cli.ts --help"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "^2.8.0"
  }
}
